            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {},
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true
}
